# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local development. Never commit the real .env.
# On Render, set these in the dashboard under Environment.
# ─────────────────────────────────────────────────────────────────────────────

# "production" enables secure cookies and proxy trust. Leave unset locally.
NODE_ENV=

# MongoDB. Local mongod for development; a MongoDB Atlas SRV string in production
# (Render has no database of its own — a localhost URI will fail to connect).
MONGO_URI=mongodb://127.0.0.1:27017/rinky_jewellers

# Session signing key — REQUIRED, the server refuses to start without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Brevo transactional email (verification + password reset)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Rinky Jewellers

# Public origin used to build links inside emails. Must match where the app is
# actually reachable, e.g. https://rinky-commerce-engine.onrender.com
BASE_URL=http://localhost:3000

# Admin account created on first boot if no user with this email exists.
# Leave blank to skip the bootstrap entirely.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
